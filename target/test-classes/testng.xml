<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Suite" parallel="tests">
	<test thread-count="5" name="Test01">
	<parameter name="browser" value="chrome"></parameter>
		<classes>
			<class name="com.qa.testCases.LoginTest"></class>
			<class name="com.qa.testCases.SearchTest"></class>
			<class name="com.qa.testCases.RegisterTest"></class>
		</classes>
	</test>
	<test thread-count="5" name="Test02">
		<parameter name="browser" value="edge"></parameter>
		<classes>
			<class name="com.qa.testCases.LogoutTest"></class>
			<class name="com.qa.testCases.Screenshot001"></class>
			<class name="com.qa.testCases.Annotation_Sequence"></class>
		</classes>
	</test>
</suite> 
